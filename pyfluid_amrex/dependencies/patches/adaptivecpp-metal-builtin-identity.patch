 namespace compiler {
 
 namespace {
+
+// The first argument of a Metal inline builtin is an operation name, not a
+// runtime pointer. Preserve that identity in the callee before optimization:
+// otherwise SimplifyCFG can sink, for example, sin/cos into one generic call
+// with a PHI of string pointers that the emitter cannot represent.
+void specializeMetalInlineBuiltins(llvm::Module &M) {
+  llvm::SmallVector<llvm::CallInst *, 32> Calls;
+  for (auto &F : M)
+    for (auto &BB : F)
+      for (auto &I : BB)
+        if (auto *CI = llvm::dyn_cast<llvm::CallInst>(&I))
+          if (auto *Callee = CI->getCalledFunction())
+            if (Callee->getName().starts_with("__acpp_sscp_metal") &&
+                !Callee->hasFnAttribute("acpp.metal.operation") &&
+                CI->arg_size() > 0)
+              Calls.push_back(CI);
+
+  for (auto *CI : Calls) {
+    llvm::StringRef Operation;
+    if (!llvm::getConstantStringInfo(CI->getArgOperand(0), Operation))
+      continue; // Truly dynamic names remain an explicit emitter error.
+
+    auto *Callee = CI->getCalledFunction();
+    std::string Name = Callee->getName().str() + ".operation.";
+    constexpr char Hex[] = "0123456789abcdef";
+    for (unsigned char C : Operation) {
+      Name += Hex[C >> 4];
+      Name += Hex[C & 15];
+    }
+    auto Specialized = M.getOrInsertFunction(Name, Callee->getFunctionType());
+    auto *Function = llvm::cast<llvm::Function>(Specialized.getCallee());
+    Function->setAttributes(Callee->getAttributes());
+    Function->addFnAttr("acpp.metal.operation", Operation);
+    Function->setCallingConv(Callee->getCallingConv());
+    CI->setCalledFunction(Function);
+    // The emitter consumes the attribute. Remove the runtime string pointer
+    // so equal strings with distinct globals cannot leave an unnecessary PHI.
+    CI->setArgOperand(0, llvm::Constant::getNullValue(CI->getArgOperand(0)->getType()));
+  }
+}
 
