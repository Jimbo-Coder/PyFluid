+// IEEE-754 binary32 classification masks used by llvm.is.fpclass.
+inline bool __acpp_metal_is_fpclass(float value, uint mask) {
+  uint bits = as_type<uint>(value);
+  uint exponent = bits & 0x7f800000u;
+  uint fraction = bits & 0x007fffffu;
+  bool negative = (bits & 0x80000000u) != 0u;
+  uint category;
+  if (exponent == 0x7f800000u) {
+    category = fraction != 0u ? ((fraction & 0x00400000u) != 0u ? 2u : 1u)
+                              : (negative ? 4u : 512u);
+  } else if (exponent == 0u) {
+    category = fraction != 0u ? (negative ? 16u : 128u)
+                              : (negative ? 32u : 64u);
+  } else {
+    category = negative ? 8u : 256u;
+  }
+  return (mask & category) != 0u;
 }
 
