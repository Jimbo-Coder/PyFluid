pyfluid.run_name = equilibrium_torus_evolution_3d
pyfluid.output_dir = runs/current/equilibrium_torus/equilibrium_torus_evolution_3d
pyfluid.validation_policy = dynamic_spacetime

mesh.coordinate = cartesian
mesh.axes = x y z
mesh.patch_system = single

geometry.prob_lo = -48.0 -48.0 -48.0
geometry.prob_hi = 48.0 48.0 48.0
geometry.is_periodic = 0 0 0

amr.n_cell = 48 48 48
amr.max_level = 0
amr.max_grid_size = 16
amr.blocking_factor = 8

spacetime.evolution = evolved
spacetime.matter_coupling = coupled
spacetime.initial_data = xcts
spacetime.lapse_gauge = frozen
spacetime.shift_gauge = frozen
spacetime.ko_dissipation = 0.0
# Radiative outer spacetime boundary for the isolated star-plus-disk system.
spacetime.outer_boundary = sommerfeld

initial_data.input_file = runs/current/equilibrium_torus/equilibrium_torus_from_spherical_id_3d/physical_id
initial_data.spacetime = id
initial_data.lapse = id
initial_data.shift = id
initial_data.disk = equilibrium_torus
initial_data.disk_gravity = coupled
initial_data.disk_rotation_law = constant_l
initial_data.disk_specific_angular_momentum = 5.2
initial_data.disk_inner_radius = 8.0
initial_data.atmosphere = power_law
initial_data.atmosphere_density = 1.0e-10
initial_data.atmosphere_pressure = 1.0e-14
initial_data.atmosphere_power = 4.0

pyfluid.physics = rhd
pyfluid.eos = hybrid_polytrope
pyfluid.eos_preset = sly
pyfluid.thermal_gamma = 2.0
pyfluid.ic = tov
pyfluid.tov_central_density = 1.28e-3
pyfluid.tov_absolute_tolerance = 1.0e-12
pyfluid.tov_relative_tolerance = 1.0e-10
pyfluid.tov_max_steps = 100000
pyfluid.rho_floor = 1.0e-12
pyfluid.pressure_floor = 1.0e-16

pyfluid.final_time = -1
pyfluid.max_step = 3
pyfluid.ng = 3
pyfluid.cfl = 0.9
pyfluid.recon = pwl
pyfluid.riemann = hll
pyfluid.timestep = ssprk3
pyfluid.subcycling = off
pyfluid.bc = outflow

pyfluid.physical_check_int = 1
pyfluid.scalar_int = 1
pyfluid.plot_int = -1
pyfluid.checkpoint_int = -1
