pyfluid.run_name = cylindrical_spiral_radiation_rphi_2d_amr
pyfluid.output_dir = runs/current/cylindrical_spiral_radiation/cylindrical_spiral_radiation_rphi_2d_amr
pyfluid.validation_policy = driven

mesh.coordinate = cylindrical
mesh.axes = r phi
mesh.patch_system = single

geometry.prob_lo = 0.0 0.0
geometry.prob_hi = 1.20 6.283185307179586
geometry.is_periodic = 0 1
geometry.coord_sys = 0

amr.n_cell = 24 16
amr.max_level = 10
amr.ref_ratio = 2 2 2 2 2 2 2 2 2 2
amr.max_grid_size = 64
amr.blocking_factor = 8
amr.regrid_int = 2
amr.grid_eff = 0.85
amr.n_error_buf = 8 8 8 8 8 8 8 8 8 8
amr.level_cell_budget_side = 1024
amr.total_cell_budget = 2000000
amr.tag_metric = auto
amr.tag_threshold = 0.30
amr.min_feature_length = 0.00001
amr.state_interp = protected

pyfluid.physics = hydro
pyfluid.ct = off
pyfluid.ic = uniform
pyfluid.eos = ideal_gas
pyfluid.rho0 = 1.0
pyfluid.pressure0 = 0.08
pyfluid.v1_0 = 0.0
pyfluid.v2_0 = 0.0
pyfluid.v3_0 = 0.0

pyfluid.source = rotating_compact_heating
pyfluid.source_power = 0.05
pyfluid.source_radius = 0.30
pyfluid.source_sigma = 0.06
pyfluid.source_omega = 6.0
pyfluid.source_ramp_time = 0.18
pyfluid.source_phase = 0.0
pyfluid.source_azimuthal_mode = 2

pyfluid.max_step = 200000
pyfluid.final_time = 0.80
pyfluid.ng = 3
pyfluid.cfl = 0.9
pyfluid.gamma = 1.6666666666666667
pyfluid.physical_check_int = 1

pyfluid.recon = wenoz
pyfluid.riemann = hllc
pyfluid.timestep = ssprk3
pyfluid.bc = outflow
pyfluid.bc_xlo = origin
pyfluid.bc_xhi = outflow
pyfluid.bc_ylo = periodic
pyfluid.bc_yhi = periodic
pyfluid.diffusion = none
pyfluid.viscosity = 0.0
pyfluid.gravity = none
pyfluid.subcycling = on
pyfluid.subcycling_steps = spatial

pyfluid.scalar_int = 10
pyfluid.plot_int = 10
pyfluid.checkpoint_int = -1
pyfluid.aux_gfs = none
pyfluid.aux_gf_compute_int = -1
pyfluid.aux_gf_int = -1
