pyfluid.run_name = mhd_rotor_2d_ct
pyfluid.output_dir = runs/current/mhd_rotor_2d_ct

geometry.prob_lo = 0.0 0.0
geometry.prob_hi = 1.0 1.0
geometry.is_periodic = 1 1

amr.n_cell = 128 128
amr.max_level = 0
amr.max_grid_size = 64
amr.blocking_factor = 16

pyfluid.physics = mhd
pyfluid.ct = on
pyfluid.max_step = 64
pyfluid.final_time = -1.0
pyfluid.ng = 2
pyfluid.cfl = 0.9
pyfluid.gamma = 1.4

pyfluid.ic = mhd_rotor
pyfluid.rho0 = 1.0
pyfluid.pressure0 = 1.0
pyfluid.bump_x0 = 0.5
pyfluid.bump_y0 = 0.5
pyfluid.rotor_radius = 0.10
pyfluid.rotor_transition_radius = 0.115
pyfluid.rotor_density = 10.0
pyfluid.rotor_omega = 20.0
pyfluid.b1_0 = 2.5
pyfluid.b2_0 = 0.0
pyfluid.b3_0 = 0.0

pyfluid.recon = pwl
pyfluid.riemann = hlld
pyfluid.timestep = ssprk3
pyfluid.bc = periodic
pyfluid.subcycling = off
pyfluid.diffusion = none

pyfluid.scalar_int = 8
pyfluid.plot_int = 16
pyfluid.checkpoint_int = -1
pyfluid.aux_gfs = j,e,divb,magnetic_energy
pyfluid.aux_gf_compute_int = 8
pyfluid.aux_gf_int = 16
