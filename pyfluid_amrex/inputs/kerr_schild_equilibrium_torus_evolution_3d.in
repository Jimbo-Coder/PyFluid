pyfluid.run_name = kerr_schild_equilibrium_torus_evolution_3d
pyfluid.output_dir = runs/current/black_hole_disk/kerr_schild_equilibrium_torus_evolution_3d
pyfluid.validation_policy = open

mesh.coordinate = cartesian
mesh.axes = x y z
mesh.patch_system = single

geometry.prob_lo = -32.0 -32.0 -32.0
geometry.prob_hi = 32.0 32.0 32.0
geometry.is_periodic = 0 0 0

amr.n_cell = 64 64 64
amr.max_level = 0
amr.max_grid_size = 32
amr.blocking_factor = 8

spacetime.evolution = fixed
spacetime.matter_coupling = coupled
spacetime.initial_data = kerr_schild
spacetime.fixed_metric = kerr_schild
spacetime.mass = 1.0
spacetime.dimensionless_spin1 = 0.0
spacetime.dimensionless_spin2 = 0.0
spacetime.dimensionless_spin3 = 0.5
spacetime.black_hole_interior = filled
spacetime.black_hole_fill_radius = 1.0

initial_data.input_file = runs/current/black_hole_disk/kerr_schild_equilibrium_torus_id_3d/physical_id
initial_data.disk = equilibrium_torus
initial_data.disk_gravity = test_fluid
initial_data.disk_rotation_law = constant_l
initial_data.disk_specific_angular_momentum = 3.7
initial_data.disk_inner_radius = 6.0
initial_data.disk_axis1 = 0.0
initial_data.disk_axis2 = 0.0
initial_data.disk_axis3 = 1.0
initial_data.atmosphere = flat
initial_data.atmosphere_density = 1.0e-10
initial_data.atmosphere_pressure = 1.0e-14

pyfluid.physics = rhd
pyfluid.eos = hybrid_polytrope
pyfluid.eos_preset = custom
pyfluid.polytropic_k = 100.0
pyfluid.polytropic_gamma = 2.0
pyfluid.thermal_gamma = 2.0
pyfluid.ic = equilibrium_torus
pyfluid.rho_floor = 1.0e-12
pyfluid.pressure_floor = 1.0e-16

pyfluid.max_step = 3
pyfluid.final_time = -1
pyfluid.ng = 3
pyfluid.cfl = 0.9
pyfluid.recon = pwl
pyfluid.riemann = hll
pyfluid.timestep = ssprk3
pyfluid.subcycling = off
pyfluid.bc = outflow

pyfluid.physical_check_int = 1
pyfluid.scalar_int = 1
pyfluid.scalar_diagnostics = standard
pyfluid.plot_int = -1
pyfluid.checkpoint_int = -1
