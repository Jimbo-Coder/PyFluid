pyfluid.run_name = magnetized_collapse_3d_amr_ct
pyfluid.output_dir = runs/current/magnetized_collapse_3d_amr_ct

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 1.0 1.0 1.0
geometry.is_periodic = 1 1 1

amr.n_cell = 24 24 24
amr.max_level = 2
amr.regrid_mode = synchronized
amr.ref_ratio = 2 2 2
amr.max_grid_size = 16
amr.blocking_factor = 8
amr.regrid_int = 2
amr.state_interp = component-conservative

pyfluid.physics = mhd
pyfluid.ct = on
pyfluid.max_step = 24
pyfluid.final_time = -1.0
pyfluid.ng = 3
pyfluid.cfl = 0.9
pyfluid.gamma = 1.6666666666666667
pyfluid.eos = ideal_gas
pyfluid.rho_floor = 1.0e-10
pyfluid.pressure_floor = 1.0e-10

pyfluid.ic = density_cloud
pyfluid.rho0 = 1.0
pyfluid.pressure0 = 0.08
pyfluid.amplitude = 6.0
pyfluid.bump_sigma = 0.105
pyfluid.bump_x0 = 0.5
pyfluid.bump_y0 = 0.5
pyfluid.bump_z0 = 0.5
pyfluid.v1_0 = 0.0
pyfluid.v2_0 = 0.0
pyfluid.v3_0 = 0.0
pyfluid.b1_0 = 0.25
pyfluid.b2_0 = 0.04
pyfluid.b3_0 = 0.0

amr.tag_metric = lohner
amr.min_feature_length = 0.0125
amr.level_cell_budget_side = 96

pyfluid.recon = pwl
pyfluid.riemann = hlld
pyfluid.timestep = ssprk3
pyfluid.bc = periodic
pyfluid.subcycling = off
pyfluid.subcycling_steps = local_cfl

pyfluid.gravity = poisson
pyfluid.gravity_constant = 1.0
pyfluid.gravity_tolerance = 1.0e-10
pyfluid.gravity_max_iterations = 250
pyfluid.gravity_max_fmg_iterations = 20
pyfluid.gravity_max_order = 2

pyfluid.diffusion = explicit
pyfluid.viscosity = 0.0
pyfluid.resistivity = 0.0005
pyfluid.diffusion_cfl = 0.9

pyfluid.aux_gfs = j,e,divb,magnetic_energy,phi,grad_phi
pyfluid.aux_gf_compute_int = 4
pyfluid.aux_gf_int = 4
pyfluid.scalar_int = 1
pyfluid.plot_int = 4
pyfluid.checkpoint_int = 12
pyfluid.profile = on
pyfluid.profile_detail = basic
