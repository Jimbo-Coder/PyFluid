pyfluid.run_name = spherical_pressure_bump_shell_2d
pyfluid.output_dir = runs/current/pressure_bump/spherical_pressure_bump_shell_2d

mesh.coordinate = spherical
mesh.patch_system = single

geometry.prob_lo = 0.45 0.08
geometry.prob_hi = 2.05 3.061592653589793
geometry.is_periodic = 0 0
geometry.coord_sys = 2

amr.n_cell = 192 256
amr.max_level = 0
amr.max_grid_size = 32
amr.blocking_factor = 8

pyfluid.max_step = 192
pyfluid.ng = 2
pyfluid.cfl = 0.9
pyfluid.gamma = 1.6666666666666667
pyfluid.physical_check_int = 1

pyfluid.physics = hydro
pyfluid.ic = pressure_bump
pyfluid.rho0 = 1.0
pyfluid.pressure0 = 1.0
pyfluid.amplitude = 0.35
pyfluid.bump_sigma = 0.14
pyfluid.bump_x0 = 1.2
pyfluid.bump_y0 = 1.5707963267948966
pyfluid.v1_0 = 0.0
pyfluid.v2_0 = 0.0
pyfluid.v3_0 = 0.0

pyfluid.recon = pwl
pyfluid.riemann = hllc
pyfluid.timestep = ssprk3
pyfluid.bc = reflecting
pyfluid.diffusion = none
pyfluid.gravity = none
pyfluid.source = none
pyfluid.subcycling = off

pyfluid.scalar_int = 4
pyfluid.plot_int = 4
