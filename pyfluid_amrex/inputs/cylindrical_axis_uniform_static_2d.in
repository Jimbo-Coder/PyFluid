pyfluid.run_name = cylindrical_axis_uniform_static_2d

mesh.coordinate = cylindrical
mesh.axes = r z
mesh.patch_system = single

geometry.prob_lo = 0.0 -0.5
geometry.prob_hi = 1.0 0.5
geometry.is_periodic = 0 0
geometry.coord_sys = 1

amr.n_cell = 96 96
amr.max_level = 0
amr.max_grid_size = 32
amr.blocking_factor = 8

pyfluid.max_step = 16
pyfluid.ng = 1
pyfluid.cfl = 0.9
pyfluid.gamma = 1.6666666666666667
pyfluid.physical_check_int = 1

pyfluid.physics = hydro
pyfluid.ic = uniform
pyfluid.rho0 = 1.0
pyfluid.pressure0 = 1.0
pyfluid.v1_0 = 0.0
pyfluid.v2_0 = 0.0
pyfluid.v3_0 = 0.0

pyfluid.recon = pwc
pyfluid.riemann = llf
pyfluid.timestep = ssprk3
pyfluid.bc = reflecting
pyfluid.bc_xlo = origin
pyfluid.diffusion = none
pyfluid.gravity = none
pyfluid.source = none
pyfluid.subcycling = off

pyfluid.scalar_int = 1
pyfluid.plot_int = -1
