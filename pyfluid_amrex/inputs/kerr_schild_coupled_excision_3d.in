pyfluid.run_name = kerr_schild_coupled_excision_3d
pyfluid.output_dir = runs/current/black_hole/kerr_schild_coupled_excision_3d
pyfluid.validation_policy = open

mesh.coordinate = cartesian
mesh.axes = x y z
mesh.patch_system = single
geometry.prob_lo = -4 -4 0
geometry.prob_hi = 4 4 4
geometry.is_periodic = 0 0 0
amr.n_cell = 32 32 16
amr.max_level = 0
amr.max_grid_size = 16
amr.blocking_factor = 8
amr.tag_metric = none

# Short coupled-excision control, not a long accretion production input.
spacetime.evolution = evolved
spacetime.matter_coupling = coupled
spacetime.initial_data = kerr_schild
spacetime.fixed_metric = minkowski
spacetime.mass = 1
spacetime.dimensionless_spin3 = 0.5
spacetime.black_hole_interior = excision
spacetime.black_hole_fill_radius = 0.75
spacetime.black_hole_matter = excision
spacetime.lapse_gauge = harmonic
spacetime.shift_gauge = frozen
spacetime.ko_dissipation = 0.32

horizon.enabled = 1
horizon.find_int = 4
horizon.radial_points = 48
horizon.polar_points = 16
horizon.coarsest_polar_points = 8
horizon.theta_linf_times_mass_tolerance = 5e-4
horizon.theta_l2_times_mass_tolerance = 1e-2
horizon.minimum_search_radius = 0.8
horizon.maximum_search_radius = 2.8
horizon.initial_radius = 1.8

pyfluid.physics = rhd
pyfluid.eos = ideal_gas
pyfluid.gamma = 1.6666666666666667
pyfluid.ic = uniform
pyfluid.rho0 = 1e-4
pyfluid.pressure0 = 1e-6
pyfluid.rho_floor = 1e-12
pyfluid.pressure_floor = 1e-12
pyfluid.final_time = -1
pyfluid.max_step = 4
pyfluid.ng = 3
pyfluid.cfl = 0.9
pyfluid.recon = pwl
pyfluid.riemann = hll
pyfluid.timestep = rk4
pyfluid.subcycling = off
pyfluid.bc = outflow
pyfluid.bc_zlo = symmetry
pyfluid.physical_check_int = 1
pyfluid.scalar_int = 1
pyfluid.scalar_diagnostics = standard
pyfluid.plot_int = -1
pyfluid.checkpoint_int = -1
