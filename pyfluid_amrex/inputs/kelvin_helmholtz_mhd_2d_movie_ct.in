pyfluid.run_name = kelvin_helmholtz_mhd_2d_movie_ct
pyfluid.output_dir = runs/current/kelvin_helmholtz_mhd_2d_movie_ct

geometry.prob_lo = 0.0 0.0
geometry.prob_hi = 1.0 1.0
geometry.is_periodic = 1 1

amr.n_cell = 64 64
amr.max_level = 4
amr.regrid_mode = synchronized
amr.ref_ratio = 2 2
amr.max_grid_size = 64
amr.blocking_factor = 16
amr.regrid_int = 16
amr.grid_eff = 0.70
amr.n_error_buf = 8 8
amr.level_cell_budget_side = 896
amr.total_cell_budget = 1000000
amr.tag_metric = lohner
amr.state_interp = quartic-conservative
amr.tag_threshold = 0.10
amr.initial_refine = box
amr.initial_refine_levels = 3
amr.initial_refine_fixed_levels = 3
amr.initial_refine_box_lo = 0.0 0.10 0.0 0.60
amr.initial_refine_box_hi = 1.0 0.40 1.0 0.90

pyfluid.physics = mhd
pyfluid.ct = on
pyfluid.max_step = 192
pyfluid.final_time = -1.0
pyfluid.ng = 3
pyfluid.cfl = 0.9
pyfluid.gamma = 1.6666666666666667

pyfluid.ic = kelvin_helmholtz_mhd
pyfluid.rho0 = 1.0
pyfluid.pressure0 = 0.25
pyfluid.v1_0 = 0.70
pyfluid.amplitude = 0.100
pyfluid.bump_sigma = 0.030
pyfluid.wave_number = 1.0
pyfluid.kh_secondary_amplitude = 0.045
pyfluid.kh_secondary_mode = 4.0
pyfluid.kh_phase = 0.41
pyfluid.kh_envelope_sigma = 0.075
pyfluid.b1_0 = 0.05
pyfluid.b2_0 = 0.0
pyfluid.b3_0 = 0.75

pyfluid.recon = wenoz
pyfluid.riemann = hlld
pyfluid.timestep = ssprk3
pyfluid.bc = periodic
pyfluid.subcycling = on

pyfluid.diffusion = explicit
pyfluid.viscosity = 0.00015
pyfluid.resistivity = 0.00015

pyfluid.scalar_int = 4
pyfluid.plot_int = 8
pyfluid.checkpoint_int = 32
pyfluid.aux_gfs = j,e,divb,magnetic_energy
pyfluid.aux_gf_compute_int = 4
pyfluid.aux_gf_int = 8
