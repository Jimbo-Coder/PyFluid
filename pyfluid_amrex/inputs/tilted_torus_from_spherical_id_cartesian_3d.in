pyfluid.run_name = tilted_torus_from_spherical_id_cartesian_3d
pyfluid.output_dir = runs/current/equilibrium_torus/tilted_torus_from_spherical_id_cartesian_3d
pyfluid.validation_policy = elliptic

mesh.coordinate = cartesian
mesh.axes = x y z

geometry.prob_lo = -36.0 -36.0 -36.0
geometry.prob_hi = 36.0 36.0 36.0
geometry.is_periodic = 0 0 0

amr.n_cell = 36 36 36
amr.max_level = 0
amr.max_grid_size = 12
amr.blocking_factor = 4

spacetime.evolution = fixed
spacetime.matter_coupling = coupled
spacetime.initial_data = xcts

initial_data.spacetime = id
initial_data.lapse = id
initial_data.shift = id
initial_data.solve_only = 1
initial_data.save_sequence = 0
initial_data.input_file = runs/current/equilibrium_torus/tilted_torus_from_cartesian_id_spherical_3d/physical_id
initial_data.output_file = runs/current/equilibrium_torus/tilted_torus_from_spherical_id_cartesian_3d/physical_id
initial_data.rotation_law = j_constant
initial_data.angular_velocity = 0.001
initial_data.differential_rotation_length = 10.0
initial_data.rotation_axis1 = 0.0
initial_data.rotation_axis2 = 0.0
initial_data.rotation_axis3 = 1.0
initial_data.disk = tilted_torus
initial_data.disk_gravity = coupled
initial_data.disk_rotation_law = constant_l
initial_data.disk_specific_angular_momentum = 5.8
initial_data.disk_inner_radius = 10.0
initial_data.disk_axis1 = 0.5
initial_data.disk_axis2 = 0.0
initial_data.disk_axis3 = 0.8660254037844386
initial_data.atmosphere = power_law
initial_data.atmosphere_density = 1.0e-13
initial_data.atmosphere_pressure = 1.0e-20
initial_data.atmosphere_power = 4.0

pyfluid.physics = rhd
pyfluid.eos = hybrid_polytrope
pyfluid.eos_preset = sly
pyfluid.thermal_gamma = 2.0
pyfluid.ic = rotating_star
pyfluid.tov_central_density = 1.28e-3
pyfluid.tov_absolute_tolerance = 1.0e-12
pyfluid.tov_relative_tolerance = 1.0e-10
pyfluid.tov_max_steps = 100000
pyfluid.rho_floor = 1.0e-15
pyfluid.pressure_floor = 1.0e-22

pyfluid.max_step = 0
pyfluid.final_time = -1
pyfluid.ng = 1
pyfluid.cfl = 0.9
pyfluid.recon = pwc
pyfluid.riemann = hll
pyfluid.timestep = euler
pyfluid.subcycling = off
pyfluid.bc = outflow

pyfluid.physical_check_int = 1
pyfluid.scalar_int = -1
pyfluid.plot_int = -1
pyfluid.checkpoint_int = -1
