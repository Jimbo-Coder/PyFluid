pyfluid.run_name = kelvin_helmholtz_mhd_3d_amr_ct
pyfluid.output_dir = runs/current/kelvin_helmholtz_mhd_3d_amr_ct

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 1.0 1.0 1.0
geometry.is_periodic = 1 1 1

amr.n_cell = 32 32 16
amr.max_level = 8
amr.ref_ratio = 2 2 2
amr.max_grid_size = 16
amr.blocking_factor = 8
amr.regrid_int = 4
amr.grid_eff = 0.85
amr.n_error_buf = 1 1 1
amr.level_cell_budget_side = 100
amr.total_cell_budget = 4000000
amr.tag_metric = auto
amr.initial_refine = box
amr.initial_refine_levels = 2
amr.initial_refine_box_lo = 0.25 0.18 0.25 0.25 0.68 0.25
amr.initial_refine_box_hi = 0.75 0.32 0.75 0.75 0.82 0.75

pyfluid.physics = mhd
pyfluid.ct = on
pyfluid.max_step = 64
pyfluid.final_time = -1.0
pyfluid.ng = 3
pyfluid.cfl = 0.9
pyfluid.gamma = 1.6666666666666667

pyfluid.ic = kelvin_helmholtz_mhd
pyfluid.rho0 = 1.0
pyfluid.pressure0 = 0.25
pyfluid.v1_0 = 0.45
pyfluid.amplitude = 0.04
pyfluid.bump_sigma = 0.035
pyfluid.wave_number = 1.0
pyfluid.kh_secondary_amplitude = 0.018
pyfluid.kh_secondary_mode = 3.0
pyfluid.kh_z_mode = 2.0
pyfluid.kh_phase = 0.37
pyfluid.kh_envelope_sigma = 0.16
pyfluid.b1_0 = 0.30
pyfluid.b2_0 = 0.0
pyfluid.b3_0 = 0.65

pyfluid.recon = wenoz
pyfluid.riemann = hlld
pyfluid.timestep = ssprk3
pyfluid.bc = periodic
pyfluid.subcycling = on

pyfluid.diffusion = explicit
pyfluid.viscosity = 0.0
pyfluid.resistivity = 0.0005
pyfluid.diffusion_cfl = 0.9

pyfluid.aux_gfs = j,e,divb,magnetic_energy
pyfluid.aux_gf_compute_int = 8
pyfluid.aux_gf_int = 8
pyfluid.scalar_int = 4
pyfluid.plot_int = 8
pyfluid.checkpoint_int = -1
