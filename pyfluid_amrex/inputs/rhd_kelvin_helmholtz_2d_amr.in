pyfluid.run_name = rhd_kelvin_helmholtz_2d_amr
pyfluid.output_dir = runs/current/rhd_kelvin_helmholtz/rhd_kelvin_helmholtz_2d_amr
pyfluid.validation_policy = closed

geometry.prob_lo = 0.0 0.0
geometry.prob_hi = 1.0 1.0
geometry.is_periodic = 1 1

amr.n_cell = 32 32
amr.max_level = 8
amr.ref_ratio = 2 2 2 2 2 2 2 2
amr.max_grid_size = 64
amr.blocking_factor = 8
amr.regrid_mode = aligned
amr.regrid_int = 4
amr.n_error_buf = 4 4 4 4 4 4 4 4
amr.tag_metric = lohner
amr.state_interp = coupled-conservative
amr.min_feature_length = 1.0e-5
amr.total_cell_budget = 500000

spacetime.evolution = fixed

pyfluid.physics = rhd
pyfluid.eos = ideal_gas
pyfluid.ic = kelvin_helmholtz
pyfluid.gamma = 1.6666666666666667
pyfluid.rho0 = 1.0
pyfluid.pressure0 = 2.5
pyfluid.v1_0 = 0.5
pyfluid.v2_0 = 0.0
pyfluid.v3_0 = 0.0
pyfluid.amplitude = 0.03
pyfluid.wave_number = 1.0
pyfluid.bump_sigma = 0.04
pyfluid.kh_density_amplitude = 0.5

pyfluid.final_time = 0.15
pyfluid.max_step = 10000
pyfluid.ng = 3
pyfluid.cfl = 0.7
pyfluid.recon = wenoz
pyfluid.riemann = hll
pyfluid.timestep = ssprk3
pyfluid.subcycling = on
pyfluid.subcycling_steps = local_cfl
pyfluid.bc = periodic

pyfluid.physical_check_int = 1
pyfluid.scalar_int = 2
pyfluid.plot_int = 8
pyfluid.checkpoint_int = -1
pyfluid.aux_gfs = amr_tag_metric
pyfluid.aux_gf_compute_int = 8
pyfluid.aux_gf_int = 8
