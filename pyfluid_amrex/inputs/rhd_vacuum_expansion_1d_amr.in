pyfluid.run_name = rhd_vacuum_expansion_1d_amr
pyfluid.output_dir = runs/current/rhd_vacuum/rhd_vacuum_expansion_1d_amr

geometry.prob_lo = 0.0
geometry.prob_hi = 1.0
geometry.is_periodic = 0

amr.n_cell = 64
amr.max_level = 1
amr.ref_ratio = 2
amr.max_grid_size = 32
amr.blocking_factor = 8
amr.regrid_mode = aligned
amr.regrid_int = 2
amr.tag_metric = lohner
amr.tag_threshold = 0.05
amr.min_feature_length = 0.001
amr.total_cell_budget = 4096
amr.state_interp = component-conservative

spacetime.evolution = fixed

pyfluid.physics = rhd
pyfluid.relativistic_exterior = vacuum
pyfluid.eos = ideal_gas
pyfluid.ic = sod_x
pyfluid.shock_x0 = 0.5
pyfluid.rho_left = 1.0
pyfluid.pressure_left = 0.2
pyfluid.v1_left = 0.0
pyfluid.v2_left = 0.0
pyfluid.v3_left = 0.0
pyfluid.rho_right = 0.0
pyfluid.pressure_right = 0.0
pyfluid.v1_right = 0.0
pyfluid.v2_right = 0.0
pyfluid.v3_right = 0.0
pyfluid.gamma = 1.6666666666666667

pyfluid.final_time = 0.1
pyfluid.max_step = 10000
pyfluid.ng = 2
pyfluid.cfl = 0.9
pyfluid.recon = pwl
pyfluid.riemann = hll
pyfluid.timestep = ssprk3
pyfluid.bc = outflow
pyfluid.subcycling = on
pyfluid.subcycling_steps = local_cfl
pyfluid.subcycling_steps = local_cfl

pyfluid.physical_check_int = 1
pyfluid.debug_check_finite = 1
pyfluid.scalar_int = 4
pyfluid.plot_int = 10000
pyfluid.checkpoint_int = -1
