pyfluid.run_name = z4c_gauge_wave_1d
pyfluid.output_dir = runs/current/z4c/z4c_gauge_wave_1d

geometry.prob_lo = 0.0
geometry.prob_hi = 1.0
geometry.is_periodic = 1

amr.n_cell = 64
amr.max_level = 0
amr.max_grid_size = 64
amr.blocking_factor = 8

spacetime.evolution = evolved
spacetime.matter_coupling = vacuum
spacetime.initial_data = gauge_wave
spacetime.lapse_gauge = harmonic
spacetime.shift_gauge = frozen
spacetime.amplitude = 1.0e-4
spacetime.wave_number = 1.0

pyfluid.physics = rhd
pyfluid.eos = ideal_gas
pyfluid.ic = uniform
pyfluid.rho0 = 1.0
pyfluid.pressure0 = 1.0
pyfluid.v1_0 = 0.0
pyfluid.v2_0 = 0.0
pyfluid.v3_0 = 0.0
pyfluid.gamma = 1.6666666666666667

pyfluid.final_time = 0.02
pyfluid.max_step = 8
pyfluid.ng = 3
pyfluid.cfl = 0.5
pyfluid.recon = pwc
pyfluid.riemann = hll
pyfluid.timestep = rk4
pyfluid.bc = periodic

pyfluid.physical_check_int = 1
pyfluid.scalar_int = 1
pyfluid.plot_int = 4
pyfluid.checkpoint_int = -1
