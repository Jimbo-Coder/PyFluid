pyfluid.run_name = spherical_origin_uniform_static_1d
pyfluid.output_dir = runs/current/uniform/spherical_origin_uniform_static_1d

mesh.coordinate = spherical
mesh.patch_system = single

geometry.prob_lo = 0.0
geometry.prob_hi = 1.0
geometry.is_periodic = 0
geometry.coord_sys = 2

amr.n_cell = 128
amr.max_level = 0
amr.max_grid_size = 64
amr.blocking_factor = 8

pyfluid.max_step = 16
pyfluid.ng = 1
pyfluid.cfl = 0.9
pyfluid.gamma = 1.6666666666666667
pyfluid.physical_check_int = 1

pyfluid.physics = hydro
pyfluid.ic = uniform
pyfluid.rho0 = 1.0
pyfluid.pressure0 = 1.0
pyfluid.v1_0 = 0.0
pyfluid.v2_0 = 0.0
pyfluid.v3_0 = 0.0

pyfluid.recon = pwc
pyfluid.riemann = llf
pyfluid.timestep = ssprk3
pyfluid.bc = reflecting
pyfluid.bc_xlo = origin
pyfluid.diffusion = none
pyfluid.gravity = none
pyfluid.source = none
pyfluid.subcycling = off

pyfluid.scalar_int = 1
pyfluid.plot_int = -1
