pyfluid.run_name = pulsating_circle_mach2_2d_amr
pyfluid.output_dir = runs/current/pulsating_circle_mach2_2d_amr

# Reflecting 2D pulsating solid in a large box.  The post-ramp peak wall
# speed is 2*pi*f*A ~= 1.41, so the wall Mach number is about 2.2 for
# gamma=5/3, rho=1, P=0.25.

geometry.prob_lo = 0.0 0.0
geometry.prob_hi = 2.0 2.0
geometry.is_periodic = 0 0

amr.n_cell = 96 96
amr.max_level = 4
amr.regrid_mode = synchronized
amr.ref_ratio = 2 2 2 2
amr.max_grid_size = 64
amr.blocking_factor = 16
amr.regrid_int = 4
amr.grid_eff = 0.85
amr.n_error_buf = 4 4 4 4
amr.level_cell_budget_side = 960
amr.total_cell_budget = 900000
amr.tag_metric = lohner
amr.tag_threshold = 0.06
amr.solid_refine_band_cells = 2.5
amr.solid_curvature_error = 2.0e-5
amr.min_feature_length = 0.0025
amr.state_interp = coupled-conservative

pyfluid.physics = hydro
pyfluid.ct = off
pyfluid.max_step = 200000
pyfluid.final_time = 0.45
pyfluid.ng = 2
pyfluid.cfl = 0.9
pyfluid.gamma = 1.6666666666666667

pyfluid.ic = uniform
pyfluid.rho0 = 1.0
pyfluid.pressure0 = 0.25
pyfluid.v1_0 = 0.0
pyfluid.v2_0 = 0.0
pyfluid.v3_0 = 0.0

pyfluid.recon = pwl
pyfluid.riemann = hllc
pyfluid.timestep = ssprk3
pyfluid.bc = reflecting

pyfluid.solid_geometry = circle
pyfluid.solid_motion = pulse
pyfluid.solid_wall_condition = slip
pyfluid.solid_center_x = 1.0
pyfluid.solid_center_y = 1.0
pyfluid.solid_radius = 0.10
pyfluid.solid_radius_amplitude = 0.025
pyfluid.solid_radius_frequency = 9.0
pyfluid.solid_radius_phase = 0.0
pyfluid.solid_radius_ramp_time = 0.1111111111111111
pyfluid.solid_swept_reference_time = 0.0
pyfluid.solid_volume_fraction_samples_per_dim = 4

pyfluid.diffusion = none
pyfluid.subcycling = off

pyfluid.scalar_int = 8
pyfluid.plot_int = 8
pyfluid.checkpoint_int = -1
pyfluid.aux_gfs = solid_mask,solid_volume_fraction,solid_swept_volume
pyfluid.aux_gf_compute_int = -1
pyfluid.aux_gf_int = 8
