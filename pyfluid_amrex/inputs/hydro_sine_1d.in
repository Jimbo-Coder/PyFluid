pyfluid.v1_0 = 0.2
pyfluid.v2_0 = 0.0
pyfluid.v3_0 = 0.0

pyfluid.recon = pwc
pyfluid.riemann = llf
pyfluid.timestep = euler
pyfluid.bc = periodic

pyfluid.scalar_int = 1
pyfluid.plot_int = -1
