pyfluid.run_name = spherical_uniform_static_3d

mesh.coordinate = spherical
mesh.patch_system = single

geometry.prob_lo = 1.0 0.3 0.0
geometry.prob_hi = 2.0 2.8415926535897933 6.283185307179586
geometry.is_periodic = 0 0 1
geometry.coord_sys = 0

amr.n_cell = 24 32 24
amr.max_level = 0
amr.max_grid_size = 16
amr.blocking_factor = 8

pyfluid.max_step = 8
pyfluid.ng = 1
pyfluid.cfl = 0.9
pyfluid.gamma = 1.6666666666666667
pyfluid.physical_check_int = 1

pyfluid.physics = hydro
pyfluid.ic = uniform
pyfluid.rho0 = 1.0
pyfluid.pressure0 = 1.0
pyfluid.v1_0 = 0.0
pyfluid.v2_0 = 0.0
pyfluid.v3_0 = 0.0

pyfluid.recon = pwc
pyfluid.riemann = llf
pyfluid.timestep = ssprk3
pyfluid.bc = reflecting
pyfluid.bc_zlo = periodic
pyfluid.bc_zhi = periodic
pyfluid.diffusion = none
pyfluid.gravity = none
pyfluid.source = none
pyfluid.subcycling = off

pyfluid.scalar_int = 1
pyfluid.plot_int = -1
