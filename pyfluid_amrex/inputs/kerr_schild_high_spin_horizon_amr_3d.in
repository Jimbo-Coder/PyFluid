pyfluid.run_name = kerr_schild_high_spin_horizon_amr_3d
pyfluid.output_dir = runs/current/black_hole_long/kerr_schild_high_spin_horizon_amr_3d
pyfluid.validation_policy = open

mesh.coordinate = cartesian
mesh.axes = x y z
mesh.patch_system = single

geometry.prob_lo = -16.0 -16.0 -16.0
geometry.prob_hi = 16.0 16.0 16.0
geometry.is_periodic = 0 0 0

amr.n_cell = 32 32 32
amr.max_level = 4
amr.ref_ratio = 2 2 2 2
amr.max_grid_size = 16
amr.blocking_factor = 8
amr.regrid_mode = synchronized
amr.regrid_int = 4
amr.n_error_buf = 2
amr.tag_metric = spacetime
amr.tag_threshold = 0.15
amr.min_feature_length = 0.25
amr.total_cell_budget = 400000
amr.level_cell_budget = 200000
amr.state_interp = quartic-conservative

spacetime.evolution = evolved
spacetime.matter_coupling = vacuum
spacetime.initial_data = kerr_schild
spacetime.mass = 1.0
spacetime.dimensionless_spin1 = 0.0
spacetime.dimensionless_spin2 = 0.0
spacetime.dimensionless_spin3 = 0.7
spacetime.black_hole_interior = filled
spacetime.black_hole_fill_radius = 1.2
spacetime.lapse_gauge = one_plus_log
spacetime.shift_gauge = gamma_driver
spacetime.shift_eta = 2.0
spacetime.ko_dissipation = 0.32
spacetime.chi_floor = 1.0e-10
spacetime.lapse_floor = 1.0e-10

horizon.enabled = 1
horizon.find_int = 4
horizon.radial_points = 64
horizon.polar_points = 24
horizon.coarsest_polar_points = 8
horizon.theta_linf_times_mass_tolerance = 5.0e-4
horizon.theta_l2_times_mass_tolerance = 1.0e-2
horizon.refine_band_cells = 0.0
horizon.minimum_search_radius = 0.4
horizon.maximum_search_radius = 2.75
horizon.initial_radius = 1.7

pyfluid.physics = rhd
pyfluid.eos = ideal_gas
pyfluid.gamma = 1.6666666666666667
pyfluid.ic = uniform
pyfluid.rho0 = 1.0e-4
pyfluid.pressure0 = 1.0e-6
pyfluid.v1_0 = 0.0
pyfluid.v2_0 = 0.0
pyfluid.v3_0 = 0.0
pyfluid.rho_floor = 1.0e-12
pyfluid.pressure_floor = 1.0e-12

pyfluid.final_time = -1
pyfluid.max_step = 16
pyfluid.ng = 3
pyfluid.cfl = 0.9
pyfluid.recon = pwl
pyfluid.riemann = hll
pyfluid.timestep = rk4
pyfluid.subcycling = on
pyfluid.subcycling_steps = spatial
pyfluid.bc = outflow

pyfluid.physical_check_int = 1
pyfluid.scalar_int = 4
pyfluid.scalar_diagnostics = standard
pyfluid.plot_int = -1
pyfluid.aux_gf_int = -1
pyfluid.checkpoint_int = -1
