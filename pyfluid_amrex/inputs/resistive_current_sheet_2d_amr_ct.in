pyfluid.run_name = resistive_current_sheet_2d_amr_ct
pyfluid.output_dir = runs/current/resistive_current_sheet_2d_amr_ct

geometry.prob_lo = 0.0 0.0
geometry.prob_hi = 1.0 1.0
geometry.is_periodic = 1 1

amr.n_cell = 16 16
amr.max_level = 12
amr.regrid_mode = aligned
amr.ref_ratio = 2 2
amr.max_grid_size = 64
amr.blocking_factor = 16
amr.regrid_int = 16
amr.grid_eff = 0.75
amr.n_error_buf = 4 4
amr.level_cell_budget_side = 1024
amr.total_cell_budget = 3000000
amr.tag_metric = lohner
amr.tag_threshold = 0.15
amr.state_interp = quartic-conservative

pyfluid.physics = mhd
pyfluid.ct = on
pyfluid.max_step = 2000
pyfluid.final_time = 0.6
pyfluid.ng = 3
pyfluid.cfl = 0.9
pyfluid.gamma = 1.6666666666666667

pyfluid.ic = resistive_current_sheet
pyfluid.rho0 = 1.0
pyfluid.pressure0 = 0.1
pyfluid.v1_0 = 0.0
pyfluid.v2_0 = 0.0
pyfluid.v3_0 = 0.0
pyfluid.b1_0 = 1.0
pyfluid.b2_0 = 0.0
pyfluid.b3_0 = 0.2
pyfluid.bump_sigma = 0.025
pyfluid.alfven_amplitude = 0.03
pyfluid.wave_number = 2.0

pyfluid.recon = wenoz-char
pyfluid.riemann = hlld
pyfluid.timestep = ssprk3
pyfluid.bc = periodic
pyfluid.subcycling = on
pyfluid.subcycling_steps = local_cfl

pyfluid.diffusion = explicit
pyfluid.viscosity = 0.0002
pyfluid.resistivity = 0.001

pyfluid.physical_check_int = 1
pyfluid.scalar_int = 1
pyfluid.plot_int = 1
pyfluid.checkpoint_int = 16
pyfluid.aux_gfs = j,e,divb,magnetic_energy
pyfluid.aux_gf_compute_int = 1
pyfluid.aux_gf_int = 2
