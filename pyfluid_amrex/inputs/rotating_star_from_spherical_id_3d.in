pyfluid.run_name = rotating_star_from_spherical_id_3d
pyfluid.output_dir = runs/current/rotating_star/rotating_star_from_spherical_id_3d
pyfluid.validation_policy = elliptic

mesh.coordinate = cartesian
mesh.axes = x y z
mesh.patch_system = single

geometry.prob_lo = -16.0 -16.0 -16.0
geometry.prob_hi = 16.0 16.0 16.0
geometry.is_periodic = 0 0 0

amr.n_cell = 32 32 32
amr.max_level = 0
amr.max_grid_size = 16
amr.blocking_factor = 8

spacetime.evolution = fixed
spacetime.matter_coupling = coupled
spacetime.initial_data = xcts

initial_data.solve_only = 1
initial_data.input_file = runs/current/rotating_star/rotating_star_xcts_spherical_sequence_2d/physical_id
initial_data.output_file = runs/current/rotating_star/rotating_star_from_spherical_id_3d/physical_id
initial_data.rotation_law = uniform
initial_data.angular_velocity = 0.028
initial_data.rotation_axis1 = 0.0
initial_data.rotation_axis2 = 0.0
initial_data.rotation_axis3 = 1.0
initial_data.atmosphere = power_law
initial_data.atmosphere_density = 1.0e-10
initial_data.atmosphere_pressure = 1.0e-14
initial_data.atmosphere_power = 4.0

pyfluid.physics = rhd
pyfluid.eos = hybrid_polytrope
pyfluid.eos_preset = sly
pyfluid.polytropic_k = 100.0
pyfluid.polytropic_gamma = 2.0
pyfluid.thermal_gamma = 2.0
pyfluid.ic = rotating_star
pyfluid.tov_central_density = 1.28e-3
pyfluid.tov_absolute_tolerance = 1.0e-12
pyfluid.tov_relative_tolerance = 1.0e-10
pyfluid.tov_max_steps = 100000
pyfluid.rho_floor = 1.0e-12
pyfluid.pressure_floor = 1.0e-16

pyfluid.max_step = 0
pyfluid.final_time = -1
pyfluid.ng = 1
pyfluid.cfl = 0.9
pyfluid.recon = pwc
pyfluid.riemann = hll
pyfluid.timestep = euler
pyfluid.subcycling = off
pyfluid.bc = outflow

pyfluid.physical_check_int = 1
pyfluid.scalar_int = -1
pyfluid.plot_int = -1
pyfluid.checkpoint_int = -1
