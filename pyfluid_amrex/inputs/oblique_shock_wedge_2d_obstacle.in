pyfluid.run_name = oblique_shock_wedge_2d_obstacle
pyfluid.output_dir = runs/current/oblique_shock_wedge_2d_obstacle

geometry.prob_lo = 0.0 0.0
geometry.prob_hi = 2.0 1.0
geometry.is_periodic = 0 0

amr.n_cell = 256 128
amr.max_level = 3
amr.ref_ratio = 2 2 2
amr.max_grid_size = 64
amr.blocking_factor = 16
amr.regrid_int = 4
amr.n_error_buf = 4 4 4
amr.tag_metric = auto
amr.tag_threshold = 0.04
amr.total_cell_budget = 1200000
amr.initial_refine = box
amr.initial_refine_levels = 2
amr.initial_refine_box_lo = 0.30 0.0
amr.initial_refine_box_hi = 1.35 0.55

pyfluid.physics = hydro
pyfluid.max_step = 100000
pyfluid.final_time = 0.50
pyfluid.ng = 1
pyfluid.cfl = 0.9
pyfluid.gamma = 1.4

pyfluid.ic = uniform
pyfluid.rho0 = 1.4
pyfluid.pressure0 = 1.0
pyfluid.v1_0 = 3.0
pyfluid.v2_0 = 0.0
pyfluid.v3_0 = 0.0

pyfluid.recon = pwc
pyfluid.riemann = hllc
pyfluid.timestep = ssprk3
pyfluid.bc = outflow
pyfluid.bc_xlo = inflow
pyfluid.bc_xhi = outflow
pyfluid.bc_ylo = reflecting
pyfluid.bc_yhi = outflow
pyfluid.inflow_rho = 1.4
pyfluid.inflow_pressure = 1.0
pyfluid.inflow_v1 = 3.0
pyfluid.inflow_v2 = 0.0
pyfluid.inflow_v3 = 0.0

pyfluid.solid_geometry = wedge
pyfluid.solid_wedge_x0 = 0.35
pyfluid.solid_wedge_y0 = 0.0
pyfluid.solid_wedge_angle_deg = 10.0

pyfluid.diffusion = none
pyfluid.subcycling = on
pyfluid.subcycling_steps = spatial

pyfluid.scalar_int = 8
pyfluid.plot_int = 8
pyfluid.checkpoint_int = -1
pyfluid.aux_gfs = solid_mask
pyfluid.aux_gf_compute_int = -1
pyfluid.aux_gf_int = 16
