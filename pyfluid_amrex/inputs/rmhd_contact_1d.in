pyfluid.b3_left = 0.5

pyfluid.rho_right = 1.0
pyfluid.pressure_right = 1.0
pyfluid.v1_right = 0.0
pyfluid.v2_right = 0.7
pyfluid.v3_right = 0.2
pyfluid.b1_right = 5.0
pyfluid.b2_right = 1.0
pyfluid.b3_right = 0.5

pyfluid.final_time = 0.1
pyfluid.max_step = 10000
pyfluid.ng = 1
pyfluid.cfl = 0.9
pyfluid.recon = pwc
pyfluid.riemann = hlld
pyfluid.timestep = ssprk3
pyfluid.bc = outflow
pyfluid.ct = off

