pyfluid.run_name = reconnecting_shear_layer_2d_capstone_ct
pyfluid.output_dir = runs/current/reconnecting_shear_layer_2d_capstone_ct

geometry.prob_lo = 0.0 -0.5
geometry.prob_hi = 2.0 0.5
geometry.is_periodic = 1 0

amr.n_cell = 64 32
amr.max_level = 12
amr.regrid_mode = aligned
amr.ref_ratio = 2 2
amr.max_grid_size = 64
amr.blocking_factor = 16
amr.regrid_int = 8
amr.grid_eff = 0.80
amr.n_error_buf = 4 4
amr.level_cell_budget_side = 2048
amr.total_cell_budget = 3000000
amr.min_feature_length = 0.0005
amr.tag_metric = lohner
amr.state_interp = quartic-conservative
amr.initial_refine = none

pyfluid.physics = mhd
pyfluid.ct = on
pyfluid.ic = reconnecting_shear_layer
pyfluid.eos = ideal_gas
pyfluid.gamma = 1.6666666666666667

pyfluid.rho0 = 1.0
pyfluid.pressure0 = 0.35
pyfluid.v1_0 = 0.70
pyfluid.b1_0 = 0.15
pyfluid.b3_0 = 0.50
pyfluid.bump_y0 = 0.0
pyfluid.bump_sigma = 0.020
pyfluid.kh_envelope_sigma = 0.080
pyfluid.wave_number = 1.0
pyfluid.kh_secondary_mode = 3.0
pyfluid.kh_phase = 0.41
pyfluid.amplitude = 0.070
pyfluid.kh_secondary_amplitude = 0.035
pyfluid.alfven_amplitude = 0.025

pyfluid.recon = wenoz-char
pyfluid.riemann = hlld
pyfluid.timestep = ssprk3
pyfluid.cfl = 0.9
pyfluid.ng = 3
pyfluid.subcycling = on
pyfluid.subcycling_steps = local_cfl
pyfluid.diffusion = explicit
pyfluid.viscosity = 0.00005
pyfluid.resistivity = 0.00005

pyfluid.bc = outflow
pyfluid.bc_xlo = periodic
pyfluid.bc_xhi = periodic
pyfluid.bc_ylo = diode
pyfluid.bc_yhi = diode

pyfluid.final_time = 1.50
pyfluid.max_step = 20000
pyfluid.physical_check_int = 1
pyfluid.scalar_int = 4
pyfluid.plot_int = 2
pyfluid.checkpoint_int = 32
pyfluid.aux_gfs = j
pyfluid.aux_gf_compute_int = 2
pyfluid.aux_gf_int = 2
