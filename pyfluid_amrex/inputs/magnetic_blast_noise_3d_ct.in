pyfluid.run_name = magnetic_blast_noise_3d_ct
pyfluid.output_dir = runs/current/magnetic_blast_noise_3d_ct

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 1.0 1.0 1.0
geometry.is_periodic = 1 1 1

amr.n_cell = 48 48 48
amr.max_level = 0
amr.max_grid_size = 16
amr.blocking_factor = 8

pyfluid.physics = mhd
pyfluid.ct = on
pyfluid.max_step = 12
pyfluid.final_time = -1.0
pyfluid.ng = 2
pyfluid.cfl = 0.9
pyfluid.gamma = 1.6666666666666667

pyfluid.ic = magnetic_blast_noise
pyfluid.rho0 = 1.0
pyfluid.pressure0 = 0.2
pyfluid.amplitude = 5.0
pyfluid.bump_sigma = 0.07
pyfluid.bump_x0 = 0.5
pyfluid.bump_y0 = 0.5
pyfluid.bump_z0 = 0.5
pyfluid.b1_0 = 0.04
pyfluid.b2_0 = 0.0
pyfluid.b3_0 = 0.08
pyfluid.alfven_amplitude = 0.04
pyfluid.wave_number = 3.0

pyfluid.recon = pwl
pyfluid.riemann = hll
pyfluid.timestep = ssprk3
pyfluid.bc = periodic

pyfluid.diffusion = explicit
pyfluid.viscosity = 0.0
pyfluid.resistivity = 0.001

pyfluid.aux_gfs = j,e,divb,magnetic_energy
pyfluid.aux_gf_compute_int = 4
pyfluid.aux_gf_int = 4
pyfluid.scalar_int = 1
pyfluid.plot_int = 4
pyfluid.checkpoint_int = -1
