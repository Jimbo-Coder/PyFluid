pyfluid.run_name = hydro_beam_obstacle_2d_amr
pyfluid.output_dir = runs/current/hydro_beam_obstacle_2d_amr

geometry.prob_lo = 0.0 0.0
geometry.prob_hi = 2.4 1.0
geometry.is_periodic = 0 0

amr.n_cell = 192 80
amr.max_level = 4
amr.regrid_mode = synchronized
amr.ref_ratio = 2 2 2 2
amr.max_grid_size = 64
amr.blocking_factor = 16
amr.regrid_int = 6
amr.grid_eff = 0.85
amr.n_error_buf = 4 4 4 4
amr.level_cell_budget_side = 1536
amr.total_cell_budget = 1400000
amr.tag_metric = lohner
amr.state_interp = coupled-conservative
amr.initial_refine = box
amr.initial_refine_levels = 1
amr.initial_refine_fixed_levels = 0
amr.initial_refine_box_lo = 0.00 0.40  1.10 0.38
amr.initial_refine_box_hi = 0.70 0.60  1.42 0.62

pyfluid.physics = hydro
pyfluid.ct = off
pyfluid.max_step = 100000
pyfluid.final_time = 0.80
pyfluid.ng = 1
pyfluid.cfl = 0.9
pyfluid.gamma = 1.4

pyfluid.ic = uniform
pyfluid.rho0 = 1.0
pyfluid.pressure0 = 1.0
pyfluid.v1_0 = 0.0
pyfluid.v2_0 = 0.0
pyfluid.v3_0 = 0.0
pyfluid.rho_right = 1.0
pyfluid.pressure_right = 1.0
pyfluid.v1_right = 0.0
pyfluid.v2_right = 0.0
pyfluid.v3_right = 0.0
pyfluid.rho_left = 1.8
pyfluid.pressure_left = 1.0
pyfluid.v1_left = 3.0
pyfluid.v2_left = 0.0
pyfluid.v3_left = 0.0
pyfluid.bump_x0 = 0.32
pyfluid.bump_y0 = 0.50
pyfluid.bump_z0 = 0.50
pyfluid.beam_length = 0.28
pyfluid.beam_radius = 0.06

pyfluid.recon = pwc
pyfluid.riemann = hllc
pyfluid.timestep = ssprk3
pyfluid.bc = outflow
pyfluid.bc_xlo = inflow
pyfluid.bc_xhi = outflow
pyfluid.bc_ylo = outflow
pyfluid.bc_yhi = outflow
pyfluid.inflow_profile = uniform_beam
pyfluid.inflow_rho = 1.8
pyfluid.inflow_pressure = 1.0
pyfluid.inflow_v1 = 3.0
pyfluid.inflow_v2 = 0.0
pyfluid.inflow_v3 = 0.0
pyfluid.inflow_background_rho = 1.0
pyfluid.inflow_background_pressure = 1.0
pyfluid.inflow_background_v1 = 0.0
pyfluid.inflow_background_v2 = 0.0
pyfluid.inflow_background_v3 = 0.0
pyfluid.inflow_center_y = 0.50
pyfluid.inflow_center_z = 0.50
pyfluid.inflow_radius = 0.06
pyfluid.diffusion = none
pyfluid.subcycling = on
pyfluid.subcycling_steps = local_cfl

pyfluid.solid_geometry = boxes
pyfluid.solid_box_lo = 1.18 0.42
pyfluid.solid_box_hi = 1.34 0.58

pyfluid.scalar_int = 4
pyfluid.plot_int = 16
pyfluid.checkpoint_int = -1
pyfluid.aux_gfs = solid_mask
pyfluid.aux_gf_compute_int = -1
pyfluid.aux_gf_int = 0
