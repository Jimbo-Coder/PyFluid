pyfluid.run_name = black_hole_xcts_spherical_id_2d
pyfluid.output_dir = runs/current/black_hole/black_hole_xcts_spherical_id_2d
pyfluid.validation_policy = elliptic

mesh.coordinate = spherical
mesh.axes = r theta
mesh.patch_system = single

# The first native constraint-solved black-hole owner is the exterior
# Schwarzschild shell. In isotropic coordinates its apparent horizon is r=M/2.
geometry.prob_lo = 0.5 0.0
geometry.prob_hi = 32.0 1.5707963267948966
geometry.is_periodic = 0 0
geometry.coord_sys = 2

amr.n_cell = 256 32
amr.max_level = 0
amr.max_grid_size = 64
amr.blocking_factor = 8

spacetime.evolution = fixed
spacetime.matter_coupling = coupled
spacetime.initial_data = xcts
spacetime.mass = 1.0

initial_data.spacetime = id
initial_data.lapse = id
initial_data.shift = id
initial_data.solve_only = 1
initial_data.radial_grid = adaptive
initial_data.adaptive_shell_width_ratio = 16.0
initial_data.output_file = runs/current/black_hole/black_hole_xcts_spherical_id_2d/physical_id
initial_data.atmosphere = flat
initial_data.atmosphere_density = 1.0e-12
initial_data.atmosphere_pressure = 1.0e-16

pyfluid.physics = rhd
pyfluid.eos = hybrid_polytrope
pyfluid.eos_preset = sly
pyfluid.thermal_gamma = 2.0
pyfluid.ic = black_hole
pyfluid.rho_floor = 1.0e-12
pyfluid.pressure_floor = 1.0e-16

pyfluid.max_step = 0
pyfluid.final_time = -1
pyfluid.ng = 1
pyfluid.cfl = 0.9
pyfluid.recon = pwc
pyfluid.riemann = hll
pyfluid.timestep = euler
pyfluid.subcycling = off
pyfluid.bc = outflow
pyfluid.bc_xlo = outflow
pyfluid.bc_ylo = symmetry
pyfluid.bc_yhi = symmetry

pyfluid.physical_check_int = 1
pyfluid.scalar_int = -1
pyfluid.plot_int = -1
pyfluid.checkpoint_int = -1
