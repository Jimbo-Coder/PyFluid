# Focused saved-sequence continuation seed for a coupled q_Omega=1.85
# black-hole disk. The full validation tier reloads it at a nearby angular
# velocity and verifies that the saved matter state seeds a new coupled solve.
pyfluid.run_name = bh_disk_qomega1p85_continuation_seed_384x80
pyfluid.output_dir = runs/current/equilibrium_torus_validation/bh_disk_qomega1p85_continuation_seed_384x80
pyfluid.validation_policy = elliptic

mesh.coordinate = spherical
mesh.axes = r theta
mesh.patch_system = single
geometry.prob_lo = 0.5 0.0
geometry.prob_hi = 192.0 1.5707963267948966
geometry.is_periodic = 0 0
geometry.coord_sys = 2
amr.n_cell = 384 80
amr.max_level = 0
amr.max_grid_size = 80
amr.blocking_factor = 8

spacetime.evolution = fixed
spacetime.matter_coupling = coupled
spacetime.initial_data = xcts
spacetime.mass = 1.0
initial_data.spacetime = id
initial_data.lapse = id
initial_data.shift = id
initial_data.solve_only = 1
initial_data.radial_grid = adaptive
initial_data.adaptive_shell_width_ratio = 16.0
initial_data.output_file = runs/current/equilibrium_torus_validation/bh_disk_qomega1p85_continuation_seed_384x80/physical_id
initial_data.disk = equilibrium_torus
initial_data.disk_gravity = coupled
initial_data.disk_rotation_law = q_power
initial_data.disk_angular_velocity = 0.1400
initial_data.disk_differential_rotation_length = 6.0
initial_data.disk_rotation_power_q = 1.0810810810810811
initial_data.disk_inner_radius = 6.0
initial_data.matter_relaxation = 0.1
initial_data.matter_relative_tolerance = 1.0e-8
initial_data.matter_max_iterations = 1024
initial_data.atmosphere = flat
initial_data.atmosphere_density = 1.0e-10
initial_data.atmosphere_pressure = 1.0e-14

pyfluid.physics = rhd
pyfluid.eos = hybrid_polytrope
pyfluid.eos_preset = custom
pyfluid.polytropic_k = 100.0
pyfluid.polytropic_gamma = 2.0
pyfluid.thermal_gamma = 2.0
pyfluid.ic = black_hole
pyfluid.rho_floor = 1.0e-12
pyfluid.pressure_floor = 1.0e-16
pyfluid.max_step = 0
pyfluid.final_time = -1
pyfluid.ng = 1
pyfluid.cfl = 0.9
pyfluid.recon = pwc
pyfluid.riemann = hll
pyfluid.timestep = euler
pyfluid.subcycling = off
pyfluid.bc = outflow
pyfluid.bc_xlo = outflow
pyfluid.bc_ylo = symmetry
pyfluid.bc_yhi = symmetry
pyfluid.physical_check_int = 1
pyfluid.scalar_int = -1
pyfluid.plot_int = -1
pyfluid.checkpoint_int = -1
