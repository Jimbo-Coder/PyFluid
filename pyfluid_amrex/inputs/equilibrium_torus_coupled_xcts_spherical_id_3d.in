pyfluid.run_name = equilibrium_torus_coupled_xcts_spherical_id_3d
pyfluid.output_dir = runs/current/equilibrium_torus/equilibrium_torus_coupled_xcts_spherical_id_3d
pyfluid.validation_policy = elliptic

mesh.coordinate = spherical
mesh.axes = r theta phi
mesh.patch_system = single

# Full periodic phi storage of the aligned axisymmetric star/torus owner.
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 128.0 1.5707963267948966 6.283185307179586
geometry.is_periodic = 0 0 1
geometry.coord_sys = 0

amr.n_cell = 96 24 4
amr.max_level = 0
amr.max_grid_size = 32
amr.blocking_factor = 1

spacetime.evolution = fixed
spacetime.matter_coupling = coupled
spacetime.initial_data = xcts

initial_data.spacetime = id
initial_data.lapse = id
initial_data.shift = id
initial_data.solve_only = 1
initial_data.radial_grid = adaptive
initial_data.adaptive_source_radius_factor = 1.5
initial_data.adaptive_exterior_fraction = 0.5
initial_data.output_file = runs/current/equilibrium_torus/equilibrium_torus_coupled_xcts_spherical_id_3d/physical_id
initial_data.disk = equilibrium_torus
initial_data.disk_gravity = coupled
initial_data.disk_rotation_law = constant_l
initial_data.disk_specific_angular_momentum = 5.2
initial_data.disk_inner_radius = 8.0
initial_data.matter_relaxation = 0.2
initial_data.matter_relative_tolerance = 1.0e-5
initial_data.matter_max_iterations = 128
initial_data.atmosphere = power_law
initial_data.atmosphere_density = 1.0e-10
initial_data.atmosphere_pressure = 1.0e-14
initial_data.atmosphere_power = 4.0

pyfluid.physics = rhd
pyfluid.eos = hybrid_polytrope
pyfluid.eos_preset = sly
pyfluid.thermal_gamma = 2.0
pyfluid.ic = tov
pyfluid.tov_central_density = 1.28e-3
pyfluid.tov_absolute_tolerance = 1.0e-12
pyfluid.tov_relative_tolerance = 1.0e-10
pyfluid.tov_max_steps = 100000
pyfluid.rho_floor = 1.0e-12
pyfluid.pressure_floor = 1.0e-16

pyfluid.max_step = 0
pyfluid.final_time = -1
pyfluid.ng = 1
pyfluid.cfl = 0.9
pyfluid.recon = pwc
pyfluid.riemann = hll
pyfluid.timestep = euler
pyfluid.subcycling = off
pyfluid.bc = outflow
pyfluid.bc_xlo = origin
pyfluid.bc_ylo = symmetry
pyfluid.bc_yhi = symmetry
pyfluid.bc_zlo = periodic
pyfluid.bc_zhi = periodic

pyfluid.physical_check_int = 1
pyfluid.scalar_int = -1
pyfluid.plot_int = -1
pyfluid.checkpoint_int = -1
