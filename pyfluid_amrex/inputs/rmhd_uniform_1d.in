pyfluid.run_name = rmhd_uniform_1d
pyfluid.output_dir = runs/current/rmhd_uniform/rmhd_uniform_1d

geometry.prob_lo = 0.0
geometry.prob_hi = 1.0
geometry.is_periodic = 1

amr.n_cell = 32
amr.max_level = 0
amr.max_grid_size = 32
amr.blocking_factor = 8

spacetime.evolution = fixed

pyfluid.physics = rmhd
pyfluid.eos = ideal_gas
pyfluid.ic = uniform
pyfluid.rho0 = 1.0
pyfluid.pressure0 = 1.0
pyfluid.v1_0 = 0.2
pyfluid.v2_0 = -0.1
pyfluid.v3_0 = 0.05
pyfluid.b1_0 = 0.75
pyfluid.b2_0 = 0.30
pyfluid.b3_0 = -0.20
pyfluid.gamma = 1.6666666666666667

pyfluid.final_time = 0.01
pyfluid.max_step = 1
pyfluid.ng = 1
pyfluid.cfl = 0.9
pyfluid.recon = pwc
pyfluid.riemann = hll
pyfluid.timestep = euler
pyfluid.bc = periodic
pyfluid.ct = off

pyfluid.physical_check_int = 1
pyfluid.scalar_int = 1
pyfluid.plot_int = 1000000
pyfluid.checkpoint_int = -1
