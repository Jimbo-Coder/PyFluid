pyfluid.run_name = black_hole_xcts_spinning_from_spherical_id_3d
pyfluid.output_dir = runs/current/black_hole/black_hole_xcts_spinning_from_spherical_id_3d
pyfluid.validation_policy = elliptic

mesh.coordinate = cartesian
mesh.axes = x y z
mesh.patch_system = single

geometry.prob_lo = -16.0 -16.0 -16.0
geometry.prob_hi = 16.0 16.0 16.0
geometry.is_periodic = 0 0 0

amr.n_cell = 64 64 64
amr.max_level = 0
amr.max_grid_size = 32
amr.blocking_factor = 8

spacetime.evolution = fixed
spacetime.matter_coupling = coupled
spacetime.initial_data = xcts
spacetime.mass = 1.0
spacetime.dimensionless_spin1 = 0.0
spacetime.dimensionless_spin2 = 0.0
spacetime.dimensionless_spin3 = 0.3
spacetime.black_hole_interior = filled
spacetime.black_hole_fill_radius = 0.5

initial_data.spacetime = id
initial_data.lapse = id
initial_data.shift = id
initial_data.solve_only = 1
initial_data.input_file = runs/current/black_hole/black_hole_xcts_spinning_spherical_id_2d/physical_id
initial_data.output_file = runs/current/black_hole/black_hole_xcts_spinning_from_spherical_id_3d/physical_id
initial_data.atmosphere = flat
initial_data.atmosphere_density = 1.0e-12
initial_data.atmosphere_pressure = 1.0e-16

pyfluid.physics = rhd
pyfluid.eos = hybrid_polytrope
pyfluid.eos_preset = sly
pyfluid.thermal_gamma = 2.0
pyfluid.ic = black_hole
pyfluid.rho_floor = 1.0e-12
pyfluid.pressure_floor = 1.0e-16

pyfluid.max_step = 0
pyfluid.final_time = -1
pyfluid.ng = 1
pyfluid.cfl = 0.9
pyfluid.recon = pwc
pyfluid.riemann = hll
pyfluid.timestep = euler
pyfluid.subcycling = off
pyfluid.bc = outflow

pyfluid.physical_check_int = 1
pyfluid.scalar_int = -1
pyfluid.plot_int = -1
pyfluid.checkpoint_int = -1
