pyfluid.run_name = tov_compose_sequence
pyfluid.output_dir = runs/current/compose_eos/tov_sequence
pyfluid.validation_policy = elliptic

amr.max_level = 0

spacetime.evolution = fixed

pyfluid.physics = rhd
pyfluid.eos = compose
pyfluid.eos_table = pyfluid_amrex/eos/compose/sly4
pyfluid.thermal_gamma = 1.8
pyfluid.ic = tov
pyfluid.tov_central_density = 1.28e-3
pyfluid.tov_absolute_tolerance = 1.0e-12
pyfluid.tov_relative_tolerance = 1.0e-10
pyfluid.tov_max_steps = 100000
pyfluid.rho_floor = 1.0e-12
pyfluid.pressure_floor = 1.0e-18

tov_sequence.central_density_min = 1.0e-4
tov_sequence.central_density_max = 3.5e-3
tov_sequence.points = 80
tov_sequence.eos_presets = custom
tov_sequence.output_dir = runs/current/compose_eos/tov_sequence

