# Share only implementation files actually used by multiple targets. Keep each
# dimension separate and leave entry points/test drivers private. Fine-grained
# object owners mean a small check never drags in unrelated solver sources.
function(pyfluid_amrex_share_implementation_objects)
   get_property(build_targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
   foreach(dim 1 2 3)
      set(dimension_targets)
      set(implementation_sources)
      foreach(target IN LISTS build_targets)
         get_target_property(target_dim ${target} PYFLUID_AMREX_DIM)
         if(target_dim STREQUAL "${dim}")
            list(APPEND dimension_targets ${target})
            get_target_property(sources ${target} SOURCES)
            list(FILTER sources INCLUDE REGEX "^src/.*\\.cpp$")
            list(APPEND implementation_sources ${sources})
         endif()
      endforeach()
      list(REMOVE_DUPLICATES implementation_sources)
      foreach(source IN LISTS implementation_sources)
         set(consumers)
         foreach(target IN LISTS dimension_targets)
            get_target_property(sources ${target} SOURCES)
            if(source IN_LIST sources)
               list(APPEND consumers ${target})
            endif()
         endforeach()
         list(LENGTH consumers consumer_count)
         if(consumer_count LESS 2)
            continue()
         endif()
         # Target-private instrumentation/options must retain private objects.
         # The registered targets otherwise share the same AMReX usage context.
         list(GET consumers 0 first_consumer)
         set(compatible TRUE)
         foreach(property COMPILE_DEFINITIONS COMPILE_OPTIONS INCLUDE_DIRECTORIES COMPILE_FEATURES)
            get_property(reference TARGET ${first_consumer} PROPERTY ${property})
            foreach(target IN LISTS consumers)
               get_property(value TARGET ${target} PROPERTY ${property})
               if(NOT "${value}" STREQUAL "${reference}")
                  set(compatible FALSE)
               endif()
            endforeach()
         endforeach()
         if(NOT compatible)
            continue()
         endif()
         string(MAKE_C_IDENTIFIER "${source}" source_id)
         set(owner "pyfluid_amrex_shared_${source_id}_${dim}d")
         add_library(${owner} OBJECT EXCLUDE_FROM_ALL ${source})
         pyfluid_amrex_configure_target(${owner} ${dim})
         foreach(property COMPILE_DEFINITIONS COMPILE_OPTIONS INCLUDE_DIRECTORIES COMPILE_FEATURES)
            get_property(value TARGET ${first_consumer} PROPERTY ${property})
            set_property(TARGET ${owner} PROPERTY ${property} "${value}")
         endforeach()
         if(TARGET pyfluid_amrex_generate_kernels)
            add_dependencies(${owner} pyfluid_amrex_generate_kernels)
         endif()
         foreach(target IN LISTS consumers)
            get_target_property(sources ${target} SOURCES)
            list(REMOVE_ITEM sources "${source}")
            list(APPEND sources "$<TARGET_OBJECTS:${owner}>")
            set_property(TARGET ${target} PROPERTY SOURCES "${sources}")
         endforeach()
      endforeach()
   endforeach()
endfunction()
